{
  "name": "carryforward",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first project maintainer: evidence-backed knowledge graph, agent instruction packs, and rule-aware change checks for one repository.",
  "license": "TBD",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "start": "node dist/server/src/index.js",
    "demo": "npm run build && npm start",
    "test": "vitest run",
    "fixture": "tsx scripts/make-fixture.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "cytoscape": "^3.34.4",
    "express": "^4.21.2",
    "parse-diff": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
